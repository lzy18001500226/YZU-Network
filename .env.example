# Copy this file to %APPDATA%\YZU-WLAN\.env and fill in your own account.
# Do not commit the resulting .env file.
SSO_USERNAME=your_student_id
SSO_PASSWORD=your_password

# Use the exact service name shown by your campus portal. Common YZU names:
# 学校互联网服务
# 移动互联网服务
# 联通互联网服务
# 电信互联网服务
# 校内免费服务
CAMPUSNET_SERVICE=学校互联网服务

# The campus wired/Wi-Fi address range and optional campus router Wi-Fi names.
# Comma-separated lists are supported. Leave CAMPUS_SSIDS empty when the CIDR is sufficient.
CAMPUS_CIDRS=10.135.0.0/17
CAMPUS_SSIDS=

# Poll once per minute when running in daemon mode.
CHECK_INTERVAL=60s
START_DELAY=5s
CHECK_URL=http://111.13.141.31/generate_204
CHECK_HOST=connect.rom.miui.com
CHECK_TIMEOUT=5s
# After this many failed cycles, request one fresh DHCP lease.
RECOVERY_FAILURES=5
RECOVERY_COOLDOWN=10m
RECOVERY_TIMEOUT=45s

DEBUG=false
LOG_FILE=$APPDATA/YZU-WLAN/yzu-wlan.log
